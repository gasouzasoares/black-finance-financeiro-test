{
  "name": "finance-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsx scripts/prepare-ocr.ts && tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "local:prepare": "tsx scripts/prepare-local.ts",
    "local:bootstrap": "tsx scripts/bootstrap-local.ts",
    "local:start": "supabase start -x studio,imgproxy,realtime,edge-runtime,logflare,vector,supavisor",
    "local:status": "supabase status",
    "smoke:worker": "tsx scripts/smoke-worker.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@vercel/functions": "^3.9.7",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "lucide-react": "^1.45.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "supabase": "^2.39.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
