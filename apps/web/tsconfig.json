{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "noUncheckedIndexedAccess": true, "noEmit": true,
    "baseUrl":".","paths":{"@/*":["src/*"]}
  },
  "include": ["src", "vite.config.ts", "../../packages/contracts/src"]
}
