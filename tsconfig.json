{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "resolveJsonModule": true, "types": ["node"],
    "baseUrl":".","paths":{"@/*":["apps/web/src/*"]}
  },
  "include": ["api/**/*.ts", "apps/api/**/*.ts", "apps/worker/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
