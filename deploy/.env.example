# Local: gere deploy/.env com scripts/start-local.ps1.
# Produção: copie este arquivo e preencha sem versionar segredos.
DATABASE_URL=postgresql://app_runtime.PROJECT_REF:SUBSTITUIR@POOLER_HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLIC_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUBSTITUIR_CHAVE_PUBLICAVEL
JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# VPS: domínio real com DNS, portas 80/443 e certificado automático.
APP_ADDRESS=financeiro.seudominio.com.br
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
